; Copy to powerfab.ini and fill in. Do NOT commit the filled version anywhere shared.
;
; mode = remote  -> goes through the Tekla PowerFab Remote Server, default port 9154,
;                   authenticates as an External User. This is what Tekla recommends
;                   and what MIW should use: better logging, narrower permissions, and
;                   no need to expose MySQL.
;
; mode = direct  -> goes straight to the MySQL database on port 3306 with a real
;                   PowerFab user account. Use only if the Remote Server is unavailable.

[powerfab]
exe      = C:\MIW\PowerFab\MIWFab.exe
mode     = remote
server   = 192.168.1.15
port     = 9154
user     = miw_api
password =
timeout  = 300
